# =============================================================================
# Restic - Related environment variables:
# =============================================================================
# NOTE: Resulting .env-* files will contain sensitive info.
#       DO NOT commit to any repository!

# -----------------------------------------------------------------------------
# Restic:
# -----------------------------------------------------------------------------
#
# Restic options:

# Name of file containing the repository location (replaces --repository-file)
#RESTIC_REPOSITORY_FILE=
# Location of repository (replaces -r)
#RESTIC_REPOSITORY=
# Location of password file (replaces --password-file)
#RESTIC_PASSWORD_FILE=
# The actual password for the repository
#RESTIC_PASSWORD=
# Command printing the password for the repository to stdout
#RESTIC_PASSWORD_COMMAND=
# Compression mode (only available for repository format version 2)
#RESTIC_COMPRESSION=
# Only consider snapshots for this host / Set the hostname for the snapshot manually (replaces --host)
#RESTIC_HOST=
# Frames per second by which the progress bar is updated
#RESTIC_PROGRESS_FPS=
# Target size for pack files
#RESTIC_PACK_SIZE=
# Concurrency for file reads
#RESTIC_READ_CONCURRENCY=

# Misc:
# Location for temporary files (except Windows)
#TMPDIR=
# Location for temporary files (only Windows)
#TMP=

# AWS / B2 / S3:
# Amazon S3 access key ID
#AWS_ACCESS_KEY_ID=
# Amazon S3 secret access key
#AWS_SECRET_ACCESS_KEY=

# Restic Server:
# Restic REST Server username
#RESTIC_REST_USERNAME=
# Restic REST Server password
#RESTIC_REST_PASSWORD=

# Documentation:
# https://restic.readthedocs.io/en/stable/040_backup.html#environment-variables
