# ==============================================================================
# OPERATING SYSTEM FILES
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ==============================================================================
# EDITORS & IDES
# ==============================================================================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (IntelliJ, PyCharm, WebStorm, etc.)
.idea/
*.iws
*.iml
*.ipr

# Eclipse
.metadata
.classpath
.project
.settings/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo

# Kate
*.kate-swp

# ==============================================================================
# GENERAL TEMPORARY & LOGS
# ==============================================================================
*.log
*.tmp
*.bak
*.swp
temp/
tmp/

# ==============================================================================
# ENVIRONMENT & SECRETS (Critical)
# ==============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ==============================================================================
# NODE.JS / JAVASCRIPT / TYPESCRIPT
# ==============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist/
build/
coverage/
.npm/

# ==============================================================================
# PYTHON
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
# Virtual Environments
venv/
env/
ENV/
.venv/

# ==============================================================================
# JAVA / KOTLIN
# ==============================================================================
*.class
*.log
*.ctxt
.mtj.tmp/
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
# Gradle
.gradle/
build/

# ==============================================================================
# C / C++
# ==============================================================================
# Prerequisites
*.d
# Compiled Object files
*.o
*.ko
*.obj
*.elf
# Linker output
*.ilk
*.map
*.exp
# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# ==============================================================================
# GO (GOLANG)
# ==============================================================================
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
# Test binary
*.test
# Output of the go coverage tool
*.out

# ==============================================================================
# RUST
# ==============================================================================
/target
**/*.rs.bk
Cargo.lock

# ==============================================================================
# PHP / LARAVEL / COMPOSER
# ==============================================================================
/vendor/
composer.phar
.phpunit.result.cache
/public/hot
/public/storage
/storage/*.key
.phpunit.result.cache

# ==============================================================================
# DOCKER & COMPOSE
# ==============================================================================
# Local override file (standard practice for local-only settings)
docker-compose.override.yml

# Custom build contexts or temporary build artifacts
.docker/

# Output of 'docker-compose config' if redirected
docker-compose.yml.config

# Elastic Beanstalk / Docker related
.elasticbeanstalk/

# If you use a script to generate .env from templates
.env.docker

# ==============================================================================
# PROJECT RELATED:
# ==============================================================================
# Custom excludes:

# Allow example files
!env*example

# Allow profiles folder
!profiles.d

